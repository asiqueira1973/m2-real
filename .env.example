# Variáveis de ambiente do Fechou por Quanto (spec.md seção 18.4).
# Copie para .env.local (nunca versionado) e preencha. Segredos só no servidor e nos
# segredos do GitHub Actions (seção 20).

# --- Web (públicas) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web (servidor) e Actions: SECRETA ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Web (servidor): disparo de workflows (seção 13.1) ---
GITHUB_TOKEN_DISPATCH=
GITHUB_REPO=

# --- Actions: coleta de anúncios (épico 8.5) ---
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CREDITOS_EXECUCAO=600

# --- Actions: coleta de leilões (épico 8.5.1) ---
ANTHROPIC_API_KEY=
CLAUDE_MAX_DOCUMENTOS_EXECUCAO=150
LEILAO_MAX_ALVOS_EXECUCAO=100
LEILAO_DOMINIOS=venda-imoveis.caixa.gov.br,portalzuk.com.br,megaleiloes.com.br,sodresantoro.com.br,frazaoleiloes.com.br,biasileiloes.com.br,lancejudicial.com.br

# --- Actions: fontes públicas ---
ITBI_PAGINA_URL=https://prefeitura.sp.gov.br/fazenda/w/acesso_a_informacao/31501
# Opcional: vazio = ler o bruto do Storage (brutos/iptu/<ano>.csv)
IPTU_ARQUIVO_URL=

